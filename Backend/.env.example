# Database (either name works in this app)
MONGO_URI=your_mongodb_connection_string
# MONGODB_URI=your_mongodb_connection_string

# Required for JWT token signing
JWT_SECRET=your_jwt_secret

# Server port (platform may override this)
PORT=5000

# Frontend URL allowed by CORS
FRONTEND_URL=https://your-site.netlify.app

# Optional: multiple frontend URLs (comma separated)
# FRONTEND_URLS=https://your-site.netlify.app,https://preview-site.netlify.app
